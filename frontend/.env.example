# URL base de la API. Si se deja vacío, el frontend consume las rutas
# relativas "/api" y las envía a través del proxy de Vite (recomendado en desarrollo).
# En producción, defina la URL pública: VITE_API_URL=https://api.techasset.pe/api
VITE_API_URL=

# Destino del proxy de desarrollo (vite.config.js)
VITE_API_PROXY=http://localhost:5080
